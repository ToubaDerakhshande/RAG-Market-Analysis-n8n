      "name": "Set Request Params"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Please provide a market analysis for {{ $json.asset }} over a {{ $json.horizon }} timeframe based on the provided news feeds. Summarize the current sentiment, key price drivers, and upcoming catalysts in clear, professional English.\n",
        "options": {
          "systemMessage": "=User requested analysis for: {{ $json.asset }}\n\nFrom the gathered RSS feeds (Investing, FXStreet, Dow Jones):\n1. Filter the headlines and content specifically relevant to \"{{ $json.market_category }}\".\n2. Summarize the current market sentiment (Bullish / Bearish / Neutral).\n3. Identify the key fundamental drivers, upcoming economic data releases, and major price levels mentioned in the news.\n4. Output the final response in clear, fluent English using clean text formatting, bullet points (such as standard dots or dashes), and proper spacing. \n\nCRITICAL FORMATTING RULES:\n- Do NOT use any markdown headers (no #, *, **, ##, ###, etc.).\n- Do NOT use any asterisks (*) for bolding or italicizing text.\n- Rely solely on line breaks, indentation, and capitalization to structure the layout cleanly and readably.\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        752,
        -48
      ],
      "id": "508e8afd-bc53-422d-b89b-967a39c8eadc",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output || \"جهت کوتاه‌مدت با داده‌های موجود روشن نیست.\";\n\nreturn {\n  json: {\n    success: true,\n    data: {\n      asset: \"gold\",\n      horizon: \"1d\",\n      direction: \"Unclear / Requires Further Investigation\",\n      summary: aiOutput,\n      factors: [\"US Inflation\",\n    \"US Federal Reserve Interest Rates\",\n    \"Physical Market Demand\"],\n      risks: [\"Unexpected volatility in the US Dollar Index (DXY)\"],\n      updated_at: new Date().toISOString().replace('T', ' ').substring(0, 19)\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        -48
      ],
      "id": "470cda76-e224-4844-9247-d55ba19b5813",
      "name": "Format JSON Response"
    },
    {
